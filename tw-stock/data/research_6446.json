n":87.87,"op_margin":40.75,"available":"2026-05-15","ttm_eps":15.63,"eps_yoy_pct":52.4},{"period":"2026Q2","year":2026,"quarter":2,"revenue":6855431,"gross_profit":6459977,"op_income":3155413,"net_income":2529964,"eps":5.56,"gross_margin":94.23,"op_margin":46.03,"available":"2026-08-14","ttm_eps":18.69,"eps_yoy_pct":122.4}],"valuation":{"date":"2026-10-22","code":"6446","pe":56.81,"dividend_yield":0.22,"pb":11.77},"pe_band":{"days":250,"min":33.9,"p25":42.2,"median":52.2,"p75":64.6,"max":97.9,"current":63.7,"ttm_eps":18.69},"fair_value":{"multiples":[42.2,52.2,64.6],"trailing":{"eps":18.69,"prices":[788.7,975.6,1207.4]}},"factset":[],"news":[],"announcements":[{"date":"2026-10-15","time":"181116","subject":"本公司新藥BESREMi（Ropeginterferon alfa-2b）獲中國 國家藥品監督管理局（NMPA）核准使用於治療成人原發性血 小板增多症（ET）","detail":"1.事實發生日:115/10/15\n2.研發新藥名稱或代號:\nBESREMi（ropeginterferon alfa-2b，即P1101，中文商品名稱為百斯瑞明）\n3.用途:\n(1)單藥適用於既往接受羥基月尿治療效果不佳的原發性血小板增多症成人患者\n(2)單藥適用於既往接受羥基月尿治療效果不佳的真性紅血球增多症成人患者\n4.預計進行之所有研發階段:不適用。\n5.目前進行中之研發階段(請說明目前之研發階段係屬提出申請/通過核准/\n不通過核准，若未通過者，請說明公司所面臨之風險及因應措施；\n另請說明未來經營方向及已投入累積研發費用):\n(1)提出申請/通過核准/不通過核准/各期人體試驗(含期中分析)結果/發生其他\n   影響新藥研發之重大事件：\n   本公司新藥BESREMi（ropeginterferon alfa-2b）針筒裝注射液劑獲中國國家\n   藥品監督管理局（NMPA）核准增加適應症，具體為：單藥適用於治療既往接\n   受羥基月尿（hydroxyurea, HU）治療效果不佳的原發性血小板增多症\n  （essential thrombocythemia, ET）成人患者，核准日期為115年10月13日，\n   本公司於115年10月15日正式接獲NMPA核發之藥品註冊證書。\n(2)未通過目的事業主管機關許可、各期人體臨床試驗(含期中分析)結果未達統計\n   上顯著意義或發生其他影響新藥研發之重大事件者，公司所面臨之風險及因應\n   措施：不適用。\n(3)已通過目的事業主管機關許可、各期人體臨床試驗(含期中分析)結果達統計上\n   顯著意義或發生其他影響新藥研發之重大事件者，未來經營方向：\n   本公司正式啟動BESREMi（ropeginterferon alfa-2b）於中國ET市場之銷售業務\n   及行銷活動。\n(4)已投入之累積研發費用：\n   考量未來市場行銷策略，保障公司及投資人權益，暫不公開揭露。\n6.將再進行之下一階段研發(請說明預計完成時間及預計應負擔之義務):不適用。\n(1)預計完成時間：不適用。\n(2)預計應負擔之義務：無。\n7.市場現況:\n原發性血小板過多症為骨髓增生性腫瘤（myeloproliferative neoplasms, MPN）\n疾病的一種，病人數與真性紅血球增多症（polycythemia vera, PV）的病人數\n相近。根據市場研究推估，中國約有40萬名ET患者。ET主要用藥為安閣靈\n（anagrelide, ANA）及仿單標示外的愛治（hydroxyurea, HU）。\n8.其他應敘明事項(若事件發生或決議之主體係屬公開發行以上公司，\n本則重大訊息同時符合證券交易法施行細則第7條第8款所定\n對股東權益或證券價格有重大影響之事項):\n(1)Ropeginterferon alfa-2b已於2024年6月獲中國NMPA核准用於治療既往接受\n   羥基月尿治療效果不佳的真性紅血球增多症成人患者。\n(2)Ropeginterferon alfa-2b為本公司自行研發生產之新一代創新長效型干擾素\n   ，至今已獲全球約50個國家核准用於成人真性紅血球增多症患者，包括美國\n   、日本、中國及歐盟等主要新藥市場；並已於台灣、澳門、日本及美國獲准\n   用於治療原發性血小板過多症。\n(3)Ropeginterferon alfa-2b為目前唯一獲中國NMPA正式核准用於治療ET的干擾\n   素療法。\n9.新藥開發時程長、投入經費高且未保證一定能成功，此等可能使投資面臨風險，投\n   資人應審慎判斷謹慎投資。:"}],"peers":[{"code":"6446","name":"藥華藥","close":1190.0,"market_cap":502697216840.0,"pe":56.81,"pb":11.77,"dividend_yield":0.22,"ttm_eps":18.69,"gross_margin":94.23,"revenue_yoy":99.97,"revenue_cum_yoy":83.53,"chg_60d":6.7,"self":true},{"code":"6919","name":"康霈*","close":67.5,"market_cap":105111058050.0,"pe":null,"pb":12.47,"dividend_yield":null,"ttm_eps":-0.16,"gross_margin":65.26,"revenue_yoy":null,"revenue_cum_yoy":-86.07,"chg_60d":-34.8,"self":false},{"code":"7799","name":"禾榮科","close":424.5,"market_cap":67175002500.0,"pe":null,"pb":6.1,"dividend_yield":null,"ttm_eps":-3.17,"gross_margin":-1506.35,"revenue_yoy":-27.01,"revenue_cum_yoy":-12.61,"chg_60d":18.2,"self":false},{"code":"6949","name":"沛爾生醫*-創","close":39.55,"market_cap":51873819550.0,"pe":null,"pb":19.23,"dividend_yield":null,"ttm_eps":-7.14,"gross_margin":-20.09,"revenue_yoy":2.27,"revenue_cum_yoy":4.06,"chg_60d":-95.6,"self":false},{"code":"6472","name":"保瑞","close":398.5,"market_cap":51015620117.0,"pe":33.22,"pb":3.4,"dividend_yield":2.48,"ttm_eps":8.96,"gross_margin":41.29,"revenue_yoy":35.12,"revenue_cum_yoy":9.44,"chg_60d":8.1,"self":false},{"code":"1795","name":"美時","close":173.5,"market_cap":46851117089.5,"pe":12.19,"pb":1.89,"dividend_yield":1.57,"ttm_eps":14.5,"gross_margin":53.68,"revenue_yoy":127.96,"revenue_cum_yoy":74.19,"chg_60d":0.9,"self":false},{"code":"6491","name":"晶碩","close":424.5,"market_cap":33111000000.0,"pe":17.64,"pb":2.81,"dividend_yield":2.37,"ttm_eps":23.71,"gross_margin":52.99,"revenue_yoy":20.64,"revenue_cum_yoy":22.27,"chg_60d":34.8,"self":false},{"code":"4123","name":"晟德","close":29.8,"market_cap":24062198961.8,"pe":null,